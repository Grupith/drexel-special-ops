rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isSplitOwner(data) {
      return isAuthenticated()
        && (
          data.createdBy == request.auth.uid
          || data.userId == request.auth.uid
        );
    }
    
    // Users collection - users can only access their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Don't allow user deletion
    }
    
    // Splits collection - users can only access their own splits
    match /splits/{splitId} {
      allow read: if isSplitOwner(resource.data);
      allow create: if isSplitOwner(request.resource.data);
      allow update: if isSplitOwner(resource.data) && isSplitOwner(request.resource.data);
      allow delete: if isSplitOwner(resource.data);

      match /subSplits/{subSplitId} {
        allow read: if isAuthenticated()
          && (
            resource.data.splitCreatedBy == request.auth.uid
            || isSplitOwner(get(/databases/$(database)/documents/splits/$(splitId)).data)
          );
        allow create, update, delete: if false;
      }
    }

    // Combi Control game profiles - no auth required for the arcade start menu.
    match /gamePlayers/{playerId} {
      allow read: if true;
      allow create: if playerId == request.resource.data.normalizedName
        && request.resource.data.keys().hasOnly([
          "name",
          "normalizedName",
          "createdAt",
          "lastPlayedAt",
          "gamesPlayed",
          "totalAisles"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName.size() > 0
        && request.resource.data.gamesPlayed is int
        && request.resource.data.gamesPlayed == 0
        && request.resource.data.totalAisles is int
        && request.resource.data.totalAisles == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastPlayedAt == request.time;
      allow update: if (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(["lastPlayedAt"])
          && request.resource.data.lastPlayedAt == request.time
        ) || (
          request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "lastPlayedAt",
            "gamesPlayed",
            "totalAisles"
          ])
          && request.resource.data.diff(resource.data).changedKeys().hasAll([
            "lastPlayedAt",
            "gamesPlayed"
          ])
          && request.resource.data.lastPlayedAt == request.time
          && request.resource.data.gamesPlayed is int
          && request.resource.data.totalAisles is int
          && (
            resource.data.keys().hasAll(["gamesPlayed"])
              ? request.resource.data.gamesPlayed == resource.data.gamesPlayed + 1
              : request.resource.data.gamesPlayed == 1
          )
          && (
            request.resource.data.diff(resource.data).changedKeys().hasAny(["totalAisles"])
              ? (
                resource.data.keys().hasAll(["totalAisles"])
                  ? request.resource.data.totalAisles >= resource.data.totalAisles
                  : request.resource.data.totalAisles >= 0
              )
              : request.resource.data.totalAisles == resource.data.totalAisles
          )
        );
      allow delete: if false;
    }

    // Combi Control scores - no auth required; scores are append-only.
    match /gameScores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          "game",
          "playerId",
          "playerName",
          "score",
          "dateKey",
          "createdAt"
        ])
        && request.resource.data.game == "combi-control"
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
