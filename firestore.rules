rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection - users can only access their own profile
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false; // Don't allow user deletion
    }
    
    // Splits collection - users can only access their own splits
    match /splits/{splitId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Combi Control game profiles - no auth required for the arcade start menu.
    match /gamePlayers/{playerId} {
      allow read: if true;
      allow create: if playerId == request.resource.data.normalizedName
        && request.resource.data.keys().hasOnly([
          "name",
          "normalizedName",
          "createdAt",
          "lastPlayedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName.size() > 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastPlayedAt == request.time;
      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly(["lastPlayedAt"])
        && request.resource.data.lastPlayedAt == request.time;
      allow delete: if false;
    }

    // Combi Control scores - no auth required; scores are append-only.
    match /gameScores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly([
          "game",
          "playerId",
          "playerName",
          "score",
          "dateKey",
          "createdAt"
        ])
        && request.resource.data.game == "combi-control"
        && request.resource.data.playerId is string
        && request.resource.data.playerId.size() > 0
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
