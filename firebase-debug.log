[debug] [2026-06-23T03:01:55.217Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/drexel-special-ops/rulesets {"name":"projects/drexel-special-ops/rulesets/293aa35a-34f4-4dc0-b802-ec78d7c934ea","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    function isAuthenticated() {\n      return request.auth != null;\n    }\n    \n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n    \n    // Users collection - users can only access their own profile\n    match /users/{userId} {\n      allow read: if isOwner(userId);\n      allow create: if isOwner(userId) && request.resource.data.uid == userId;\n      allow update: if isOwner(userId);\n      allow delete: if false; // Don't allow user deletion\n    }\n    \n    // Splits collection - users can only access their own splits\n    match /splits/{splitId} {\n      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;\n      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;\n      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;\n    }\n\n    // Combi Control game profiles - no auth required for the arcade start menu.\n    match /gamePlayers/{playerId} {\n      allow read: if true;\n      allow create: if playerId == request.resource.data.normalizedName\n        && request.resource.data.keys().hasOnly([\n          \"name\",\n          \"normalizedName\",\n          \"createdAt\",\n          \"lastPlayedAt\"\n        ])\n        && request.resource.data.name is string\n        && request.resource.data.name.size() > 0\n        && request.resource.data.normalizedName is string\n        && request.resource.data.normalizedName.size() > 0\n        && request.resource.data.createdAt == request.time\n        && request.resource.data.lastPlayedAt == request.time;\n      allow update: if request.resource.data.diff(resource.data).changedKeys().hasOnly([\"lastPlayedAt\"])\n        && request.resource.data.lastPlayedAt == request.time;\n      allow delete: if false;\n    }\n\n    // Combi Control scores - no auth required; scores are append-only.\n    match /gameScores/{scoreId} {\n      allow read: if true;\n      allow create: if request.resource.data.keys().hasOnly([\n          \"game\",\n          \"playerId\",\n          \"playerName\",\n          \"score\",\n          \"dateKey\",\n          \"createdAt\"\n        ])\n        && request.resource.data.game == \"combi-control\"\n        && request.resource.data.playerId is string\n        && request.resource.data.playerId.size() > 0\n        && request.resource.data.playerName is string\n        && request.resource.data.playerName.size() > 0\n        && request.resource.data.score is int\n        && request.resource.data.score > 0\n        && request.resource.data.dateKey is string\n        && request.resource.data.dateKey.matches(\"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\")\n        && request.resource.data.createdAt == request.time;\n      allow update, delete: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-06-23T03:01:55.236015Z","metadata":{"services":["cloud.firestore"]}}
